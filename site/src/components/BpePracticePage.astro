---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getEntry, render } from 'astro:content';
import BpeLab from './BpeLab.astro';

const { lang } = Astro.props as { lang: 'ru' | 'en' };
const id = lang === 'ru' ? 'practice/byte-pair-encoding' : 'en/practice/byte-pair-encoding';
const entry = await getEntry('docs', id);
if (!entry) throw new Error('Missing BPE practice: ' + id);
const { Content, headings } = await render(entry);
const { hero: _hero, editUrl, ...frontmatter } = entry.data;
const labHeading = { depth: 2, slug: 'bpe-lab', text: lang === 'ru' ? 'Объединения по шагам' : 'Merges, step by step' };
---

<StarlightPage frontmatter={{ ...frontmatter, editUrl: editUrl === true ? undefined : editUrl }} headings={[labHeading, ...headings]}>
  <BpeLab lang={lang} heading={labHeading.text} />
  <Content />
</StarlightPage>
