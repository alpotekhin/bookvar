<section class="attention-lab" aria-labelledby="lab-title">
  <header class="lab-heading">
    <p class="lab-eyebrow">Интерактивная лаборатория</p>
    <h2 id="lab-title">Увидеть причинную маску в действии</h2>
    <p>Меняйте оценки сходства и наблюдайте, какие связи доступны каждому токену. Затем нарушьте маску и выполните проверки: лаборатория покажет не только ошибку, но и её причину.</p>
  </header>

  <div class="lab-controls" aria-label="Настройки внимания">
    <label>Сила связи «читает → книгу»
      <input id="past-score" type="range" min="-2" max="6" step="0.5" value="3" />
      <output id="past-value">3</output>
    </label>
    <label>Сила запрещённой будущей связи
      <input id="future-score" type="range" min="-2" max="6" step="0.5" value="5" />
      <output id="future-value">5</output>
    </label>
    <label class="lab-toggle"><input id="causal-mask" type="checkbox" checked /> Применять причинную маску</label>
  </div>

  <div class="lab-stage">
    <div>
      <h3>Матрица весов внимания</h3>
      <p class="lab-caption">Строка — токен, который читает контекст; столбец — токен, к которому он обращается.</p>
      <div id="attention-grid" class="attention-grid" role="table" aria-label="Матрица весов внимания"></div>
    </div>
    <div>
      <h3>Что видит токен «читает»</h3>
      <div id="token-flow" class="token-flow" aria-live="polite"></div>
      <p id="explanation" class="lab-explanation"></p>
    </div>
  </div>

  <div class="lab-actions">
    <button id="run-checks" type="button">Проверить реализацию</button>
    <button id="reset-lab" class="secondary" type="button">Сбросить</button>
  </div>
  <ol id="check-results" class="check-results" aria-live="polite"></ol>
</section>

<script>
  const tokens = ['Она', 'читает', 'книгу', '.'];
  const past = document.querySelector<HTMLInputElement>('#past-score')!;
  const future = document.querySelector<HTMLInputElement>('#future-score')!;
  const mask = document.querySelector<HTMLInputElement>('#causal-mask')!;
  const grid = document.querySelector<HTMLElement>('#attention-grid')!;
  const flow = document.querySelector<HTMLElement>('#token-flow')!;
  const explanation = document.querySelector<HTMLElement>('#explanation')!;
  const results = document.querySelector<HTMLOListElement>('#check-results')!;

  const softmax = (values: number[]) => {
    const max = Math.max(...values);
    const exp = values.map((value) => Math.exp(value - max));
    const sum = exp.reduce((a, b) => a + b, 0);
    return exp.map((value) => value / sum);
  };

  function scoresFor(row: number) {
    const base = [1, 2, 0.5, -0.5];
    if (row === 1) {
      base[0] = Number(past.value);
      base[2] = Number(future.value);
    }
    return base.map((value, column) => mask.checked && column > row ? -Infinity : value);
  }

  function weightsFor(row: number) {
    const scores = scoresFor(row);
    const finite = scores.map((value) => Number.isFinite(value) ? value : -1e9);
    return softmax(finite).map((value, column) => Number.isFinite(scores[column]) ? value : 0);
  }

  function render() {
    document.querySelector<HTMLOutputElement>('#past-value')!.textContent = past.value;
    document.querySelector<HTMLOutputElement>('#future-value')!.textContent = future.value;
    const cells = ['<span class="corner" aria-hidden="true"></span>', ...tokens.map((t) => `<b>${t}</b>`)];
    tokens.forEach((token, row) => {
      cells.push(`<b>${token}</b>`);
      weightsFor(row).forEach((weight, column) => {
        const blocked = mask.checked && column > row;
        const alpha = blocked ? 0 : Math.max(0.08, weight);
        cells.push(`<span class="weight ${blocked ? 'blocked' : ''}" style="--weight:${alpha}" title="${blocked ? 'связь запрещена маской' : weight.toFixed(3)}">${blocked ? '×' : weight.toFixed(2)}</span>`);
      });
    });
    grid.innerHTML = cells.join('');

    const row = weightsFor(1);
    flow.innerHTML = tokens.map((token, i) => `<span style="--weight:${Math.max(0.08, row[i])}" class="flow-token ${row[i] === 0 ? 'blocked' : ''}"><b>${token}</b><small>${row[i].toFixed(2)}</small></span>`).join('');
    explanation.textContent = mask.checked
      ? 'Оценка будущего токена может быть сколь угодно большой: после маскирования его вес остаётся нулевым. Softmax нормирует только разрешённые позиции.'
      : 'Без маски токен «читает» обращается к слову «книгу», хотя при авторегрессионной генерации это слово ещё неизвестно. Так возникает утечка будущего.';
    results.innerHTML = '';
  }

  function runChecks() {
    const rows = tokens.map((_, i) => weightsFor(i));
    const checks: Array<[string, boolean]> = [
      ['Форма матрицы равна 4 × 4', rows.length === 4 && rows.every((row) => row.length === 4)],
      ['Каждая строка суммируется в единицу', rows.every((row) => Math.abs(row.reduce((a, b) => a + b, 0) - 1) < 1e-9)],
      ['Все будущие позиции имеют нулевой вес', rows.every((row, i) => row.every((value, j) => j <= i || value === 0))],
      ['Первый токен видит только себя', rows[0][0] === 1 && rows[0].slice(1).every((value) => value === 0)],
      ['Изменение будущей оценки не влияет на прошлый выход', mask.checked && rows[1][2] === 0],
    ];
    results.innerHTML = checks.map(([label, ok]) => `<li class="${ok ? 'pass' : 'fail'}"><b>${ok ? 'Пройдено' : 'Ошибка'}:</b> ${label}${ok ? '' : ' — включите причинную маску и проверьте, какие столбцы доступны строке.'}</li>`).join('');
  }

  [past, future, mask].forEach((control) => control.addEventListener('input', render));
  document.querySelector<HTMLButtonElement>('#run-checks')!.addEventListener('click', runChecks);
  document.querySelector<HTMLButtonElement>('#reset-lab')!.addEventListener('click', () => {
    past.value = '3'; future.value = '5'; mask.checked = true; render();
  });
  render();
</script>

<style>
  .attention-lab{margin:2rem 0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--sl-color-gray-5);border-radius:1rem;background:linear-gradient(145deg,var(--sl-color-gray-7),var(--sl-color-bg));box-shadow:0 1rem 3rem #0001}
  .lab-eyebrow{margin:0;color:var(--sl-color-accent-high);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.75rem}.lab-heading h2{margin:.25rem 0 .5rem}.lab-heading p:last-child{max-width:70ch}
  .lab-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.lab-controls label{display:grid;grid-template-columns:1fr auto;gap:.4rem;font-weight:600}.lab-controls input[type=range]{grid-column:1/-1;width:100%}.lab-toggle{grid-column:1/-1!important;display:flex!important;align-items:center;gap:.6rem!important}
  .lab-stage{display:grid;grid-template-columns:minmax(19rem,1fr) minmax(15rem,.8fr);gap:1.5rem}.lab-stage h3{margin:.4rem 0}.lab-caption{font-size:.85rem;color:var(--sl-color-gray-2)}
  .attention-grid{display:grid;grid-template-columns:repeat(5,minmax(3.2rem,1fr));gap:.35rem}.attention-grid>*{display:grid;place-items:center;min-height:2.8rem;text-align:center}.weight{border:1px solid color-mix(in srgb,var(--sl-color-accent) 45%,transparent);border-radius:.5rem;background:color-mix(in srgb,var(--sl-color-accent) calc(var(--weight)*70%),var(--sl-color-bg));font-variant-numeric:tabular-nums}.weight.blocked{background:repeating-linear-gradient(135deg,transparent,transparent 5px,var(--sl-color-gray-6) 5px,var(--sl-color-gray-6) 10px);color:var(--sl-color-gray-3)}
  .token-flow{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem;margin-top:1rem}.flow-token{display:flex;justify-content:space-between;padding:.7rem;border-radius:.6rem;background:color-mix(in srgb,var(--sl-color-accent) calc(var(--weight)*70%),var(--sl-color-bg));border:1px solid var(--sl-color-gray-5)}.flow-token.blocked{opacity:.5}.lab-explanation{padding:1rem;border-left:3px solid var(--sl-color-accent);background:var(--sl-color-gray-6);border-radius:.25rem}
  .lab-actions{display:flex;gap:.7rem;margin-top:1.4rem}.lab-actions button{border:0;border-radius:.55rem;padding:.7rem 1rem;font:inherit;font-weight:700;cursor:pointer;background:var(--sl-color-accent-high);color:var(--sl-color-black)}.lab-actions .secondary{background:var(--sl-color-gray-5);color:var(--sl-color-white)}.check-results{padding-left:1.3rem}.check-results li{margin:.45rem 0;padding:.4rem .6rem;border-radius:.35rem}.check-results .pass{background:color-mix(in srgb,#2eae62 18%,transparent)}.check-results .fail{background:color-mix(in srgb,#d84b4b 18%,transparent)}
  @media(max-width:50rem){.lab-stage,.lab-controls{grid-template-columns:1fr}.attention-grid{font-size:.8rem;overflow-x:auto}.attention-grid>*{min-width:2.8rem}.lab-actions{flex-wrap:wrap}}
</style>
