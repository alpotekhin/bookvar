<section class="attention-lab" aria-labelledby="lab-title">
  <header class="lab-heading">
    <p class="lab-eyebrow">Интерактивная лаборатория</p>
    <h2 id="lab-title">Увидеть причинную маску в действии</h2>
    <p>Увеличьте оценку связи с будущим словом «книгу». При включённой маске его вес останется нулевым. Отключите маску и сравните распределения весов.</p>
  </header>

  <div class="lab-controls" aria-label="Настройки внимания">
    <label>Сила связи «читает → Она»
      <input id="past-score" type="range" min="-2" max="6" step="0.5" value="3" />
      <output id="past-value">3</output>
    </label>
    <label>Сила будущей связи «читает → книгу»
      <input id="future-score" type="range" min="-2" max="6" step="0.5" value="5" />
      <output id="future-value">5</output>
    </label>
    <label class="lab-toggle"><input id="causal-mask" type="checkbox" checked /> Применять причинную маску</label>
  </div>

  <div class="lab-stage">
    <div>
      <h3>Матрица весов внимания</h3>
      <p class="lab-caption">Строка — токен, который читает контекст; столбец — токен, к которому он обращается.</p>
      <div class="attention-grid-scroll">
        <table id="attention-grid" class="attention-grid" aria-label="Матрица весов внимания"></table>
      </div>
    </div>
    <div>
      <h3>Что видит токен «читает»</h3>
      <div id="token-flow" class="token-flow" aria-live="polite"></div>
      <p id="explanation" class="lab-explanation"></p>
    </div>
  </div>

  <div class="lab-actions">
    <button id="run-checks" type="button">Проверить свойства внимания</button>
    <button id="reset-lab" class="secondary" type="button">Сбросить</button>
  </div>
  <ol id="check-results" class="check-results" aria-live="polite"></ol>
</section>

<script>
  import { attentionTokens as tokens, attentionWeights, checkAttention } from '../lib/causal-attention';
  const past = document.querySelector<HTMLInputElement>('#past-score')!;
  const future = document.querySelector<HTMLInputElement>('#future-score')!;
  const mask = document.querySelector<HTMLInputElement>('#causal-mask')!;
  const grid = document.querySelector<HTMLElement>('#attention-grid')!;
  const flow = document.querySelector<HTMLElement>('#token-flow')!;
  const explanation = document.querySelector<HTMLElement>('#explanation')!;
  const results = document.querySelector<HTMLOListElement>('#check-results')!;

  const settings = () => ({
    pastScore: Number(past.value), futureScore: Number(future.value), causal: mask.checked,
  });

  function render() {
    document.querySelector<HTMLOutputElement>('#past-value')!.textContent = past.value;
    document.querySelector<HTMLOutputElement>('#future-value')!.textContent = future.value;
    const rows = attentionWeights(settings());
    const cells = ['<thead><tr><td></td>', ...tokens.map((t) => `<th scope="col">${t}</th>`), '</tr></thead><tbody>'];
    tokens.forEach((token, row) => {
      cells.push(`<tr><th scope="row">${token}</th>`);
      rows[row].forEach((weight, column) => {
        const blocked = mask.checked && column > row;
        const alpha = blocked ? 0 : Math.max(0.08, weight);
        cells.push(`<td class="weight ${blocked ? 'blocked' : ''}" style="--weight:${alpha}" title="${blocked ? 'связь запрещена маской' : weight.toFixed(3)}">${blocked ? '×' : weight.toFixed(2)}</td>`);
      });
      cells.push('</tr>');
    });
    cells.push('</tbody>');
    grid.innerHTML = cells.join('');

    const row = rows[1];
    flow.innerHTML = tokens.map((token, i) => `<span style="--weight:${Math.max(0.08, row[i])}" class="flow-token ${row[i] === 0 ? 'blocked' : ''}"><b>${token}</b><small>${row[i].toFixed(2)}</small></span>`).join('');
    explanation.textContent = mask.checked
      ? 'Оценка будущего токена может быть сколь угодно большой: после маскирования его вес остаётся нулевым. Softmax нормирует только разрешённые позиции.'
      : 'Без маски токен «читает» обращается к слову «книгу», хотя при авторегрессионной генерации это слово ещё неизвестно. Так возникает утечка будущего.';
    results.innerHTML = '';
  }

  function runChecks() {
    const checks = checkAttention(settings());
    results.innerHTML = checks.map(([label, ok]) => `<li class="${ok ? 'pass' : 'fail'}"><b>${ok ? 'Пройдено' : 'Ошибка'}:</b> ${label}${ok ? '' : ' — включите причинную маску и проверьте, какие столбцы доступны строке.'}</li>`).join('');
  }

  [past, future, mask].forEach((control) => control.addEventListener('input', render));
  document.querySelector<HTMLButtonElement>('#run-checks')!.addEventListener('click', runChecks);
  document.querySelector<HTMLButtonElement>('#reset-lab')!.addEventListener('click', () => {
    past.value = '3'; future.value = '5'; mask.checked = true; render();
  });
  render();
</script>

<style>
  .attention-lab{margin:2rem 0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--sl-color-gray-5);border-radius:1rem;background:linear-gradient(145deg,var(--sl-color-gray-7),var(--sl-color-bg));box-shadow:0 1rem 3rem #0001}
  .lab-eyebrow{margin:0;color:var(--sl-color-accent-high);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.75rem}.lab-heading h2{margin:.25rem 0 .5rem}.lab-heading p:last-child{max-width:70ch}
  .lab-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.lab-controls label{display:grid;grid-template-columns:1fr auto;gap:.4rem;font-weight:600}.lab-controls input[type=range]{grid-column:1/-1;width:100%}.lab-toggle{grid-column:1/-1!important;display:flex!important;align-items:center;gap:.6rem!important}
  .lab-stage{display:grid;grid-template-columns:1fr;gap:1.5rem}.lab-stage>div{min-width:0}.lab-stage h3{margin:.4rem 0}.lab-caption{font-size:.85rem;color:var(--sl-color-gray-2)}
  .attention-grid-scroll{max-width:100%;overflow-x:auto}
  .attention-lab .attention-grid{display:table;contain:none;width:100%;margin:0;border-collapse:separate;border-spacing:.25rem;font-size:.9rem}
  .attention-grid :global(th),.attention-grid :global(td){padding:.4rem .2rem;min-width:2.3rem;height:2.8rem;text-align:center;border:0}
  .attention-grid :global(.weight){border:1px solid color-mix(in srgb,var(--sl-color-accent) 45%,transparent);border-radius:.5rem;background:color-mix(in srgb,var(--sl-color-accent) calc(var(--weight)*70%),var(--sl-color-bg));font-variant-numeric:tabular-nums}
  .attention-grid :global(.weight.blocked){background:repeating-linear-gradient(135deg,transparent,transparent 5px,var(--sl-color-gray-6) 5px,var(--sl-color-gray-6) 10px);color:var(--sl-color-gray-3)}
  .token-flow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;margin-top:1rem}
  .token-flow :global(.flow-token){display:flex;align-items:baseline;justify-content:space-between;gap:.5rem;min-width:0;padding:.7rem;border-radius:.6rem;background:color-mix(in srgb,var(--sl-color-accent) calc(var(--weight)*70%),var(--sl-color-bg));border:1px solid var(--sl-color-gray-5)}
  .token-flow :global(.flow-token.blocked){opacity:.5}
  .token-flow :global(small){margin:0;font-variant-numeric:tabular-nums}
  .lab-explanation{padding:1rem;border-left:3px solid var(--sl-color-accent);background:var(--sl-color-gray-6);border-radius:.25rem}
  .lab-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.4rem}.lab-actions button{border:0;border-radius:.55rem;padding:.7rem 1rem;font:inherit;font-weight:700;cursor:pointer;background:var(--sl-color-accent-high);color:var(--sl-color-black)}.lab-actions .secondary{background:var(--sl-color-gray-5);color:var(--sl-color-white)}
  .check-results{padding-left:1.3rem}.check-results :global(li){margin:.45rem 0;padding:.4rem .6rem;border-radius:.35rem}.check-results :global(.pass){background:color-mix(in srgb,#2eae62 18%,transparent)}.check-results :global(.fail){background:color-mix(in srgb,#d84b4b 18%,transparent)}
  @media(max-width:50rem){.lab-controls{grid-template-columns:1fr}.attention-grid{font-size:.8rem}.attention-grid :global(th),.attention-grid :global(td){min-width:2rem}}
</style>
