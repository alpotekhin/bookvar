<dialog class="figure-viewer" data-figure-viewer aria-labelledby="figure-viewer-title" data-pagefind-ignore>
  <div class="figure-viewer-toolbar">
    <h2 id="figure-viewer-title" data-viewer-label="title">Иллюстрация</h2>
    <div class="figure-viewer-controls">
      <button type="button" data-viewer-minus aria-label="Уменьшить">−</button>
      <output data-viewer-scale aria-live="polite">1×</output>
      <button type="button" data-viewer-plus aria-label="Увеличить">+</button>
      <button type="button" data-viewer-fit data-viewer-label="fit">Целиком</button>
      <a data-viewer-original target="_blank" rel="noopener" data-viewer-label="file">Файл</a>
      <button type="button" data-viewer-close data-viewer-label="close" autofocus>Закрыть</button>
    </div>
  </div>
  <div class="figure-viewer-viewport" data-viewer-viewport tabindex="0" aria-label="Область изображения">
    <img data-viewer-image alt="" draggable="false" />
    <p data-viewer-error hidden>Не удалось загрузить изображение. Откройте исходный файл.</p>
  </div>
  <p class="figure-viewer-caption" data-viewer-caption></p>
</dialog>

<script>
  import { initializeFigureViewer } from './figure-viewer';
  initializeFigureViewer();
  document.addEventListener('astro:page-load', () => initializeFigureViewer());
</script>

