---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CausalAttentionLab from '../../components/CausalAttentionLab.astro';

const baseHref = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<StarlightPage frontmatter={{ title: 'Причинное self-attention: интерактивная лаборатория', description: 'Пошаговая проверка причинной маски и весов внимания.' }}>
  <p class="practice-lead">При авторегрессионной генерации позиция может использовать только уже известную часть последовательности. Эта лаборатория показывает, где причинная маска входит в вычисление и почему одной треугольной картинки недостаточно для проверки реализации.</p>
  <CausalAttentionLab />
  <h2>Связь с реализацией</h2>
  <p>В коде запрещённые элементы матрицы оценок заменяют на <code>-∞</code> до применения softmax. После экспоненцирования их вклад становится нулевым, а разрешённые элементы строки нормируются до суммы, равной единице.</p>
  <pre><code>{`scores = (q @ k.transpose(-2, -1)) / sqrt(head_dim)
scores = scores.masked_fill(~causal_mask, -inf)
weights = softmax(scores, dim=-1)
output = weights @ v`}</code></pre>
  <p><a href={`${baseHref}textbook/transformer/self-attention/`}>Вернуться к подробному объяснению Q, K и V</a>.</p>
</StarlightPage>

<style>
  .practice-lead {
    max-width: 68ch;
    margin: 0 0 2rem;
    color: var(--sl-color-gray-2);
    font-size: 1.08rem;
    line-height: 1.75;
  }
</style>
