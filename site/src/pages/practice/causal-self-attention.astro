---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CausalAttentionLab from '../../components/CausalAttentionLab.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('docs', 'practice/causal-self-attention');
if (!entry) throw new Error('Missing canonical causal-attention practice page');
const { Content, headings } = await render(entry);
// StarlightPage accepts raw frontmatter; entry.data has already transformed
// fields such as hero icons. This practice page has no hero.
const { hero: _hero, editUrl, ...frontmatter } = entry.data;
const rawEditUrl = editUrl === true ? undefined : editUrl;
---

<StarlightPage frontmatter={{ ...frontmatter, editUrl: rawEditUrl }} headings={[{ depth: 2, slug: 'lab-title', text: 'Увидеть причинную маску в действии' }, ...headings]}>
  <CausalAttentionLab />
  <Content />
</StarlightPage>
